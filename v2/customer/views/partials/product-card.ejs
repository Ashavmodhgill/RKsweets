<article class="catalog-card <%= product.isAvailable ? '' : 'unavailable-card' %>">
  <a class="card-image" href="/products/<%= encodeURIComponent(product.slug) %>">
    <% if (product.imageUrl) { %><img src="<%= product.imageUrl %>" alt="<%= product.name %>" loading="lazy"><% } else { %><span class="image-placeholder" aria-hidden="true">RK</span><% } %>
    <% if (!product.isAvailable) { %><span class="unavailable-badge">Currently unavailable</span><% } %>
  </a>
  <div class="card-copy">
    <p class="card-category"><%= product.category %></p><h2><a href="/products/<%= encodeURIComponent(product.slug) %>"><%= product.name %></a></h2>
    <p class="card-description"><%= product.description %></p>
    <div class="card-meta"><strong>₹<%= (product.pricePaise / 100).toFixed(2) %></strong><span><%= product.unitType === 'weight' ? `${product.weightAmount} ${product.weightUnit}` : `${product.quantityPerPiece} per piece` %></span></div>
    <p class="prep-time">Estimated preparation: <%= product.prepMinutes %> min</p>
    <form class="cart-add-form" method="post" action="/cart/items/<%= encodeURIComponent(product._id) %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" <%= product.isAvailable ? '' : 'disabled' %>><%= product.isAvailable ? 'Add to cart' : 'Unavailable' %></button>
    </form>
  </div>
</article>
