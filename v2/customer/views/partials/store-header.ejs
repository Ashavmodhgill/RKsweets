<header class="store-header">
  <a class="store-brand" href="/" aria-label="RK Sweets home"><img class="store-brand-mark" src="/assets/images/logo.png" alt="RK Sweets logo"><span><strong>RK Sweets</strong><small>MADE FOR SHARING</small></span></a>
  <button class="store-menu-toggle" type="button" aria-label="Open store navigation" aria-controls="store-navigation" aria-expanded="false" id="store-menu-toggle">☰</button>
  <nav class="store-nav" id="store-navigation" aria-label="Store navigation">
    <a class="<%= activePath === '/' ? 'active' : '' %>" href="/">Home</a>
    <a class="<%= activePath.startsWith('/products') ? 'active' : '' %>" href="/products">Our sweets</a>
    
      <a class="<%= activePath === '/cart' ? 'active' : '' %>" href="/cart">
        Cart
        <span class="cart-count" aria-label="<%= typeof cartItemCount !== 'undefined' ? cartItemCount : 0 %> items"><%= typeof cartItemCount !== 'undefined' ? cartItemCount : 0 %></span>
      </a>

    <a class="<%= activePath.startsWith('/orders') ? 'active' : '' %>" href="/orders">My orders</a>
    <a class="store-notification-link <%= activePath.startsWith('/notifications') ? 'active' : '' %>" href="/notifications" aria-label="Notifications"><span aria-hidden="true">♢</span><span class="notification-link-label">Alerts</span><span class="notification-badge" data-notification-count data-notification-count-url="/notifications/unread-count" aria-live="polite" hidden>0</span></a>
    <a class="<%= activePath === '/profile' ? 'active' : '' %>" href="/profile">My account</a>
  </nav>
  <div class="store-account"><span class="store-greeting">Hello, <%= account.name %></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out</button></form></div>
</header>
