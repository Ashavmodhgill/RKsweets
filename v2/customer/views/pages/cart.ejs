<%- include('../partials/head', { pageTitle, assetPrefix: '/assets' }) %>
<body class="storefront">
  <%- include('../partials/store-header', { account, activePath: '/cart' }) %>
  <main class="store-main cart-main">
    <section class="cart-heading">
      <p class="eyebrow">YOUR RK SWEETS SELECTION</p>
      <h1>Your cart</h1>
      <p>Review your sweets and quantities before continuing to the catalogue.</p>
    </section>
    <% if (cartNotice) { %><p class="cart-notice" role="status"><%= cartNotice %></p><% } %>
    <% if (notice) { %><p class="cart-notice" role="status"><%= notice %></p><% } %>
    <% if (!cart.items.length) { %>
      <section class="cart-empty">
        <span class="cart-empty-mark" aria-hidden="true">RK</span>
        <h2>Your cart is waiting for something sweet.</h2>
        <p>Browse the current catalogue and add available sweets to your cart.</p>
        <a class="store-button" href="/products">Continue shopping <span aria-hidden="true">→</span></a>
      </section>
    <% } else { %>
      <div class="cart-layout">
        <section class="cart-lines" aria-label="Items in your cart">
          <% cart.items.forEach((item) => { %>
            <article class="cart-line">
              <a class="cart-line-image" href="/products/<%= encodeURIComponent(item.slug) %>" aria-label="View <%= item.name %>">
                <% if (item.imageUrl) { %><img src="<%= item.imageUrl %>" alt="" loading="lazy"><% } else { %><span aria-hidden="true">RK</span><% } %>
              </a>
              <div class="cart-line-info">
                <p class="card-category"><%= item.unitType === 'weight' ? 'WEIGHT PACK' : 'SWEET' %></p>
                <h2><a href="/products/<%= encodeURIComponent(item.slug) %>"><%= item.name %></a></h2>
                <p class="cart-unit">Unit: <%= item.unitLabel %></p>
                <p class="cart-unit-price">₹<%= (item.pricePaise / 100).toFixed(2) %> per unit</p>
              </div>
              <form class="cart-quantity-form" method="post" action="/cart/items/<%= encodeURIComponent(item.productId) %>/update">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label for="cart-quantity-<%= item.productId %>">Quantity</label>
                <div><input id="cart-quantity-<%= item.productId %>" name="quantity" type="number" min="1" max="99" step="1" value="<%= item.quantity %>" required><button type="submit">Update</button></div>
              </form>
              <div class="cart-line-total"><small>Subtotal</small><strong>₹<%= (item.lineSubtotalPaise / 100).toFixed(2) %></strong></div>
              <form class="cart-remove-form" method="post" action="/cart/items/<%= encodeURIComponent(item.productId) %>/remove">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" aria-label="Remove <%= item.name %> from cart">Remove</button>
              </form>
            </article>
          <% }) %>
        </section>
        <aside class="cart-summary" aria-label="Cart summary">
          <p class="eyebrow">ORDER SUMMARY</p>
          <h2>Cart total</h2>
          <div><span>Items</span><strong><%= cart.itemCount %></strong></div>
          <div class="cart-summary-total"><span>Total</span><strong>₹<%= (cart.totalPaise / 100).toFixed(2) %></strong></div>
          <p>Prices reflect the current catalogue. Payment is made in person: at the counter for pickup or with staff for dine-in.</p>
          <a class="store-button cart-checkout-button" href="/checkout">Continue to checkout <span aria-hidden="true">→</span></a>
          <a class="store-button" href="/products">Continue shopping <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    <% } %>
  </main>
  <%- include('../partials/store-footer') %>
  <%- include('../partials/foot', { assetPrefix: '/assets' }) %>
</body>
</html>
