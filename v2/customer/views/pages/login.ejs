<%- include('../partials/head', { pageTitle, assetPrefix: '/assets' }) %>
<body class="portal portal-customer">
  <main class="container auth-card">
    <p class="eyebrow">RK SWEETS · CUSTOMER</p>
    <h1>Welcome back</h1>
    <% if (errorMessage) { %><p class="form-error" role="alert"><%= errorMessage %></p><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="mobile">Mobile number</label>
      <input id="mobile" name="mobile" type="tel" inputmode="tel" autocomplete="tel" placeholder="+14155550123" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit">Sign in</button>
    </form>
    <p class="auth-switch">New to RK Sweets? <a href="/register">Create an account</a></p>
  </main>
  <%- include('../partials/foot', { assetPrefix: '/assets' }) %>
</body>
</html>
