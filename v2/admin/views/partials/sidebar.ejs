<aside class="admin-sidebar" id="admin-sidebar" aria-label="Owner navigation">
  <a class="admin-brand" href="/" aria-label="RK Sweets dashboard">
    <img class="brand-mark" src="/assets/images/logo.png" alt="RK Sweets logo"><span><strong>RK Sweets</strong><small>OWNER PORTAL</small></span>
  </a>
  <p class="sidebar-label">WORKSPACE</p>
  <nav class="admin-nav">
    <a class="<%= activePath === '/' ? 'active' : '' %>" href="/" <%= activePath === '/' ? 'aria-current="page"' : '' %>><span class="nav-icon">⌂</span>Dashboard</a>
    <a class="<%= activePath.startsWith('/products') ? 'active' : '' %>" href="/products" <%= activePath.startsWith('/products') ? 'aria-current="page"' : '' %>><span class="nav-icon">✦</span>Products</a>
    <a class="<%= activePath.startsWith('/categories') ? 'active' : '' %>" href="/categories" <%= activePath.startsWith('/categories') ? 'aria-current="page"' : '' %>><span class="nav-icon">◇</span>Categories</a>
  </nav>
  <p class="sidebar-label sidebar-label-spaced">OPERATIONS</p>
  <nav class="admin-nav" aria-label="Operations">
    <a class="<%= activePath.startsWith('/orders') ? 'active' : '' %>" href="/orders" <%= activePath.startsWith('/orders') ? 'aria-current="page"' : '' %>><span class="nav-icon">▤</span>Orders</a>
    <a class="<%= activePath.startsWith('/business-days') ? 'active' : '' %>" href="/business-days" <%= activePath.startsWith('/business-days') ? 'aria-current="page"' : '' %>><span class="nav-icon">◷</span>Business Day</a>
    <a class="<%= activePath.startsWith('/dining') ? 'active' : '' %>" href="/dining" <%= activePath.startsWith('/dining') ? 'aria-current="page"' : '' %>><span class="nav-icon">▦</span>Dining tables</a>
    <a class="<%= activePath.startsWith('/orders') ? 'active' : '' %>" href="/orders" <%= activePath.startsWith('/orders') ? 'aria-current="page"' : '' %>><span class="nav-icon">▧</span>Receipts<small>Browse by order</small></a>
  </nav>
  <p class="sidebar-label sidebar-label-spaced">PREFERENCES</p>
  <nav class="admin-nav"><span class="nav-disabled"><span class="nav-icon">⚙</span>Settings<small>Coming soon</small></span></nav>
  <div class="sidebar-bottom">
    <div class="sidebar-shop-note"><span class="shop-status-dot"></span><span><strong>RK Sweets</strong><small>Product catalogue</small></span></div>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sidebar-logout" type="submit"><span class="nav-icon">↪</span>Sign out</button></form>
  </div>
</aside>
