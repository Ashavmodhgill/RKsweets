<%- include('../partials/head', { pageTitle, assetPrefix: '/assets' }) %>
<body class="admin-app">
  <%- include('../partials/app-shell-start', { pageTitle, account, activePath: '/orders' }) %>
    <a class="inline-link order-back-link" href="/orders">← Back to orders</a>
    <% if (notice) { %><p class="notice" role="status"><%= ({ accepted: 'Order accepted. The token and preparation estimate are now visible to the customer.', rejected: 'Order rejected. The customer can see your reason.', completed: 'Order marked complete.', 'already-processed': 'This order has already been processed.', 'invalid-transition': 'This order cannot be completed from its current status.', 'reason-required': 'Enter a reason when changing the suggested preparation estimate.', conflict: 'The order changed while you were processing it. Refresh and review its current status.', 'not-found': 'Order not found.' })[notice] || notice %></p><% } %>
    <% if (!order) { %><section class="empty-state"><h2>Order not found</h2><p>This order may have been removed or the link is invalid.</p><a class="button-secondary" href="/orders">Return to orders</a></section><% } else { %>
      <section class="dashboard-panel owner-order-detail">
        <div class="owner-order-card-head"><div><p class="eyebrow">PLACED <%= new Date(order.createdAt).toLocaleString() %></p><h2>Order <%= order.officialToken ? `#${order.officialToken}` : 'awaiting token' %></h2></div><span class="status order-status"><%= labels[order.status] || order.status %></span></div>
        <div class="order-detail-grid"><section><h3>Customer</h3><p><strong><%= order.customerSnapshot.name %></strong><br><a href="tel:<%= order.customerSnapshot.mobile %>"><%= order.customerSnapshot.mobile %></a></p></section><section><h3>Fulfilment</h3><p><%= order.fulfillmentMethod === 'dine_in' ? `Dine-in · Table ${order.tableSnapshot?.tableNumber || '—'}` : 'Pickup' %><br>Payment in person</p></section><% if (order.acceptedAt) { %><section><h3>Acceptance</h3><p><%= new Date(order.acceptedAt).toLocaleString() %><br>Token <strong><%= order.tokenDate %> · <%= order.officialToken %></strong></p></section><% } %></div>
        <h3>Items</h3><ul class="owner-order-items detail-items"><% order.items.forEach((item) => { %><li><span><strong><%= item.name %></strong><br><%= item.unitLabel %> × <%= item.quantity %> · ₹<%= (item.unitPricePaise / 100).toFixed(2) %> each · <%= item.prepMinutes %> min item prep snapshot</span><strong>₹<%= (item.lineTotalPaise / 100).toFixed(2) %></strong></li><% }) %></ul>
        <div class="order-total-line"><span>Total</span><strong>₹<%= (order.totalPaise / 100).toFixed(2) %></strong></div>
        <% if (order.status === 'pending_owner_acceptance') { %>
          <section class="order-action-panel"><h3>Accept order</h3><p>Suggested estimate: <strong><%= suggestedPrepMinutes %> minutes</strong>. This uses the longest item preparation snapshot, assuming parallel preparation; it is not a queue prediction or exact completion promise.</p><form method="post" action="/orders/<%= order._id %>/accept" class="order-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="confirmed-prep">Confirmed preparation estimate (minutes)</label><input id="confirmed-prep" name="confirmedPrepMinutes" type="number" min="0" max="1440" step="1" required value="<%= suggestedPrepMinutes %>"><label for="adjustment-reason">Adjustment reason (required if you change the suggestion)</label><input id="adjustment-reason" name="adjustmentReason" type="text" maxlength="300"><button class="button-primary" type="submit">Accept and issue token</button></form></section>
          <section class="order-action-panel order-reject-panel"><h3>Reject order</h3><form method="post" action="/orders/<%= order._id %>/reject" class="order-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="rejection-reason">Reason shown to the customer</label><textarea id="rejection-reason" name="reason" rows="3" maxlength="500" required></textarea><button class="button-danger" type="submit">Reject order</button></form></section>
        <% } else { %>
          <% if (order.rejectionReason) { %><section class="order-action-panel"><h3>Rejection reason</h3><p><%= order.rejectionReason %></p><small>Rejected <%= new Date(order.rejectedAt).toLocaleString() %></small></section><% } %>
          <% if (Number.isSafeInteger(order.confirmedPrepMinutes)) { %><section class="order-action-panel"><h3>Preparation estimate</h3><p><%= order.confirmedPrepMinutes %> minutes<% if (order.suggestedPrepMinutes !== order.confirmedPrepMinutes) { %> (suggested <%= order.suggestedPrepMinutes %>; adjusted: <%= order.prepTimeAdjustmentReason %>)<% } %></p></section><% } %>
          <% if (['accepted', 'preparing', 'ready'].includes(order.status)) { %><section class="order-action-panel"><h3>Complete order</h3><p>Mark this order complete after handoff.</p><form method="post" action="/orders/<%= order._id %>/complete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-primary" type="submit">Mark completed</button></form></section><% } else if (order.completedAt) { %><p class="order-completed-note">Completed <%= new Date(order.completedAt).toLocaleString() %></p><% } %>
        <% } %>
      </section>
    <% } %>
  <%- include('../partials/app-shell-end') %>
  <%- include('../partials/foot', { assetPrefix: '/assets' }) %>
</body>
</html>
