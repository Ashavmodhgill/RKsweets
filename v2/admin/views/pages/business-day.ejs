<%- include('../partials/head', { pageTitle, assetPrefix: '/assets' }) %>
<body class="admin-app">
  <%- include('../partials/app-shell-start', { pageTitle, account, activePath: '/business-days' }) %>
    <div class="page-toolbar"><p>Owner-controlled opening and closing for <strong><%= businessDate %></strong> in <%= businessTimezone %>.</p><a class="inline-link" href="/business-days/reports">Historical reports →</a></div>
    <% const noticeText = ({ opened: 'Business day opened.', closing: 'Ordering and new acceptances are paused. Resolve the outstanding orders below before finalizing.', outstanding: 'The day remains in closing because unresolved orders still exist.', BUSINESS_DAY_ALREADY_ACTIVE: 'Another business day is already open or closing.', BUSINESS_DAY_CLOSED: 'A closed business day cannot be reopened.', BUSINESS_DAY_PRIOR_ORDERS: 'Resolve all outstanding orders from an earlier day before opening this one.', BUSINESS_DAY_NOT_OPEN: 'There is no open business day to close.', BUSINESS_DAY_NOT_CLOSING: 'There is no business day ready to finalize.', BUSINESS_DAY_FINALIZE_CONFLICT: 'The day changed during closing. Refresh and retry.' })[notice]; %>
    <% if (noticeText) { %><p class="business-day-notice" role="status"><%= noticeText %></p><% } %>
    <section class="business-day-heading">
      <div><p class="eyebrow">DAILY OPERATIONS</p><h2><%= day ? day.businessDate : businessDate %></h2><p>All dates follow the configured business timezone.</p></div>
      <span class="business-day-status status status-<%= day?.status || 'not-open' %>"><%= day?.status ? (day.status === 'closing' ? 'Closing' : day.status[0].toUpperCase() + day.status.slice(1)) : 'Not open' %></span>
    </section>
    <% if (day?.openedAt) { %><section class="business-day-times dashboard-panel"><div><span>Opened</span><strong><%= new Date(day.openedAt).toLocaleString() %></strong><small>Owner: <%= day.openedBy ? String(day.openedBy) : '—' %></small></div><% if (day.closingRequestedAt) { %><div><span>Closing requested</span><strong><%= new Date(day.closingRequestedAt).toLocaleString() %></strong></div><% } %><% if (day.closedAt) { %><div><span>Closed</span><strong><%= new Date(day.closedAt).toLocaleString() %></strong></div><% } %></section><% } %>
    <section class="business-day-metrics metric-grid" aria-label="Business day order summary">
      <article class="metric-card"><div><p>Orders placed</p><strong><%= summary.totalOrderCount %></strong><small>Current business date</small></div></article>
      <article class="metric-card"><div><p>Gross order value</p><strong>₹<%= (summary.grossOrderValuePaise / 100).toFixed(2) %></strong><small>Based on saved order price snapshots</small></div></article>
      <article class="metric-card"><div><p>Completed</p><strong><%= summary.statusCounts.completed || 0 %></strong><small>Payment is not implied</small></div></article>
    </section>
    <p class="business-day-payment-note"><%= paidSalesMessage %></p>

    <% if (!day || day.status === 'closed') { %>
      <section class="dashboard-panel business-day-action"><h2><%= day?.status === 'closed' ? 'This date is finalized' : 'Open the shop for orders' %></h2><p><%= day?.status === 'closed' ? 'The report is fixed. A new business day must be opened explicitly on its business date.' : 'Opening is explicit. Customers can place orders only after the day is open.' %></p><% if (!day) { %><% if (priorUnresolved.length) { %><div class="business-day-blocked"><strong>Opening is blocked:</strong> <%= priorUnresolved.length %> unresolved order<%= priorUnresolved.length === 1 ? '' : 's' %> from an earlier or legacy day must be resolved first.<ul><% priorUnresolved.forEach((order) => { %><li><a href="/orders/<%= order._id %>">Order <%= order.officialToken ? `${order.tokenDate} · ${order.officialToken}` : 'awaiting token' %></a> · <%= statusLabels[order.status] || order.status %></li><% }) %></ul></div><% } else { %><form method="post" action="/business-days/open"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-primary" type="submit">Open Business Day</button></form><% } %><% } else { %><a class="button-secondary" href="/business-days/reports/<%= day.businessDate %>">View finalized report</a><% } %></section>
    <% } else if (day.status === 'open') { %>
      <section class="dashboard-panel business-day-action"><h2>Business day is open</h2><p>New checkout and owner acceptance are enabled. Requesting close immediately pauses both.</p><form method="post" action="/business-days/close"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="business-day-confirm"><input type="checkbox" name="confirm" value="yes" required> I understand that new orders and acceptances will stop.</label><button class="button-danger" type="submit">Begin Closing</button></form></section>
    <% } else { %>
      <section class="dashboard-panel business-day-action"><h2>Resolve outstanding orders</h2><p>The day is closing. New orders and acceptances are blocked. Complete active orders or reject eligible pending orders using their order pages.</p>
        <% if (outstanding.length) { %><div class="business-day-outstanding"><h3><%= outstanding.length %> unresolved order<%= outstanding.length === 1 ? '' : 's' %></h3><ul><% outstanding.forEach((order) => { %><li><a href="/orders/<%= order._id %>">Order <%= order.officialToken ? `#${order.tokenDate} · ${order.officialToken}` : 'awaiting token' %></a><span><%= order.customerSnapshot?.name || 'Customer' %></span><strong><%= statusLabels[order.status] || order.status %></strong><% if (!statusLabels[order.status]) { %><small>This status requires owner review; it is not automatically changed.</small><% } %></li><% }) %></ul></div><p class="business-day-blocked">Finalization is blocked until every pending, accepted, preparing, and ready order is resolved.</p>
        <% } else { %><p class="business-day-clear">No unresolved orders remain. Finalization will recheck this condition and save the report atomically.</p><form method="post" action="/business-days/finalize"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="business-day-confirm"><input type="checkbox" name="confirm" value="yes" required> I confirm the day report and final closure.</label><button class="button-primary" type="submit">Finalize & Close Day</button></form><% } %>
      </section>
    <% } %>
    <section class="business-day-status-summary dashboard-panel"><h2>Orders by status</h2><div class="business-day-status-grid"><% Object.entries(summary.statusCounts || {}).forEach(([key, count]) => { %><div><span><%= statusLabels[key] || key %></span><strong><%= count %></strong></div><% }) %></div></section>
  <%- include('../partials/app-shell-end') %>
  <%- include('../partials/foot', { assetPrefix: '/assets' }) %>
</body>
</html>
