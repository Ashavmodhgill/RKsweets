<%- include('../partials/head', { pageTitle, assetPrefix: '/assets' }) %>
<body class="admin-app">
  <%- include('../partials/app-shell-start', { pageTitle, account, activePath: '/dining' }) %>
  <div class="page-toolbar"><p>Manage table QR credentials and current dining visits. A completed order never clears a table automatically.</p></div>
  <% const notices = { created: 'Table created. Save the QR URL now; the credential is stored only as a hash.', updated: 'Table updated.', 'qr-regenerated': 'The previous QR credential is now revoked. Save the new URL now.', cleared: 'The table visit was manually cleared.', 'not-occupied': 'This table has no current visit to clear.', 'already-cleared': 'This table visit has already been cleared.', 'unresolved-orders': 'Clearance is blocked while unresolved orders remain. Their current order links and statuses are listed below.', 'deactivation-blocked': 'Resolve current activity and manually clear the visit before deactivating the table.', duplicate: 'A table already uses that number.' }; %>
  <% if (notice && notices[notice]) { %><p class="business-day-notice" role="status"><%= notices[notice] %></p><% } %>
  <% if (issuedQrUrl) { %><section class="dashboard-panel dining-qr-issued"><h2>Save this QR destination path now</h2><p>It will not be displayed again. Use your trusted customer-portal QR publishing process to add the public site origin. Generate a replacement if it is lost.</p><code><%= issuedQrUrl %></code><button type="button" class="button-secondary" data-copy-value="<%= issuedQrUrl %>">Copy path</button><span data-copy-status role="status"></span></section><% } %>
  <section class="dashboard-panel dining-create"><h2>Add a table</h2><form method="post" action="/dining/tables" class="dining-create-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Table number<input name="tableNumber" required maxlength="32" autocomplete="off"></label><button class="button-primary" type="submit">Create table</button></form></section>
  <nav class="dining-filters" aria-label="Filter tables"><% [['all','All'],['available','Available'],['occupied','Occupied'],['pending','Pending'],['outstanding','Outstanding orders'],['inactive','Inactive']].forEach(([key,label]) => { %><a class="<%= filter === key ? 'active' : '' %>" href="/dining<%= key === 'all' ? '' : `?filter=${key}` %>"><%= label %></a><% }) %></nav>
  <section class="dining-table-grid" aria-label="Dining tables">
    <% if (!tables.length) { %><div class="empty-state"><h2>No tables configured</h2><p>Create a table to issue a secure dining QR destination.</p></div><% } %>
    <% tables.forEach((table) => { const orders = table.orders || []; const unresolvedStatuses = ['pending_owner_acceptance','accepted','preparing','ready']; const outstanding = orders.filter((order) => unresolvedStatuses.includes(order.status)); const legacyOutstanding = table.legacyOrders.some((order) => unresolvedStatuses.includes(order.status)); const anyOutstanding = outstanding.length > 0 || legacyOutstanding; %>
      <article class="dashboard-panel dining-table-card">
        <header><div><p class="eyebrow">TABLE</p><h2><%= table.tableNumber %></h2></div><span class="status <%= !table.isActive ? 'status-off' : table.visit?.status === 'occupied' ? 'status-live' : table.visit?.status === 'pending' || legacyOutstanding ? 'status-pending' : 'status-off' %>"><%= !table.isActive ? 'Inactive' : table.visit?.status === 'occupied' ? 'Occupied' : table.visit?.status === 'pending' ? 'Pending order' : legacyOutstanding ? 'Legacy order review' : 'Available' %></span></header>
        <% if (table.visit) { %><p>Visit began <%= new Date(table.visit.openedAt).toLocaleString() %><% if (table.visit.occupiedAt) { %> · Occupied <%= new Date(table.visit.occupiedAt).toLocaleString() %><% } %></p><p><strong><%= outstanding.length %></strong> unresolved order<%= outstanding.length === 1 ? '' : 's' %> · <strong><%= orders.length %></strong> total orders this visit</p>
          <% if (orders.length) { %><ul class="dining-order-list"><% orders.forEach((order) => { %><li><a href="/orders/<%= order._id %>">Order <%= order.officialToken ? `#${order.tokenDate} · ${order.officialToken}` : 'awaiting acceptance' %></a><span><%= order.customerSnapshot.name %> · <%= order.status.replaceAll('_', ' ') %></span><a href="/orders/<%= order._id %>/receipt">Receipt</a></li><% }) %></ul><% } %>
          <form method="post" action="/dining/tables/<%= table._id %>/clear"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="business-day-confirm"><input type="checkbox" name="confirm" value="yes" required <%= anyOutstanding ? 'disabled' : '' %>> I confirm the occupants have physically left and the table is clear.</label><button class="button-secondary" type="submit" <%= anyOutstanding ? 'disabled title="Resolve all outstanding orders first"' : '' %>>Mark table cleared</button></form>
        <% } else { %><p>No current visit. Previous visits and orders remain in history.</p><% } %>
        <% if (table.legacyOrders.length) { %><section class="dining-legacy-orders"><h3>Orders without visit records</h3><p>These orders predate visit tracking. Resolve any outstanding items before deactivating or clearing related dining operations.</p><ul class="dining-order-list"><% table.legacyOrders.forEach((order) => { %><li><a href="/orders/<%= order._id %>">Legacy order <%= order.officialToken ? `#${order.tokenDate} · ${order.officialToken}` : 'awaiting acceptance' %></a><span><%= order.customerSnapshot.name %> · <%= order.status.replaceAll('_', ' ') %></span><a href="/orders/<%= order._id %>/receipt">Receipt</a></li><% }) %></ul></section><% } %>
        <form method="post" action="/dining/tables/<%= table._id %>/rename" class="dining-rename-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Table label<input name="tableNumber" value="<%= table.tableNumber %>" maxlength="32" required></label><button class="text-button" type="submit">Save label</button></form>
        <div class="dining-table-actions"><form method="post" action="/dining/tables/<%= table._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isActive" value="<%= table.isActive ? 'false' : 'true' %>"><button class="text-button" type="submit" <%= table.isActive && (table.visit || anyOutstanding) ? 'disabled title="Resolve orders and clear the current visit first"' : '' %>><%= table.isActive ? 'Deactivate' : 'Activate' %></button></form><form method="post" action="/dining/tables/<%= table._id %>/qr" data-confirm="Replace this QR credential? All existing QR copies will stop working."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Regenerate QR</button></form></div>
      </article>
    <% }) %>
  </section>
  <%- include('../partials/app-shell-end') %>
  <%- include('../partials/foot', { assetPrefix: '/assets' }) %>
</body>
</html>
