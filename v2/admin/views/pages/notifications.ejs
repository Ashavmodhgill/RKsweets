<%- include('../partials/head', { pageTitle, assetPrefix: '/assets' }) %>
<body class="admin-app">
  <%- include('../partials/app-shell-start', { pageTitle, account, activePath: '/notifications' }) %>
    <div class="page-toolbar notification-toolbar"><p>Updates for the RK Sweets owner account.</p><p id="notification-refresh-status" role="status" aria-live="polite">Loading unread count…</p></div>
    <% if (notifications.some((notification) => !notification.readAt)) { %><form method="post" action="/notifications/read-all" class="mark-all-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="notification-action">Mark all as read</button></form><% } %>
    <% if (!notifications.length) { %><section class="empty-state notification-empty"><h2>You’re all caught up</h2><p>New customer orders and other order updates will appear here.</p></section><% } else { %>
      <section class="notification-list owner-notification-list" aria-label="Owner notifications">
        <% notifications.forEach((notification) => { %><article class="notification-card <%= notification.readAt ? 'is-read' : 'is-unread' %>"><div class="notification-copy"><p class="notification-event"><%= notification.eventType.replaceAll('_', ' ') %></p><h2><%= notification.title %></h2><p><%= notification.message %></p><time datetime="<%= notification.createdAt.toISOString() %>"><%= new Date(notification.createdAt).toLocaleString() %></time><a class="notification-order-link" href="<%= notification.orderUrl %>">Review order <span aria-hidden="true">→</span></a></div><% if (!notification.readAt) { %><form method="post" action="/notifications/<%= notification._id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="notification-action">Mark read</button></form><% } else { %><span class="notification-read-label">Read</span><% } %></article><% }) %>
      </section>
    <% } %>
  <%- include('../partials/app-shell-end') %>
  <%- include('../partials/foot', { assetPrefix: '/assets' }) %>
</body>
</html>
