<%- include('../partials/head', { pageTitle, assetPrefix: '/assets' }) %>
<body class="portal portal-admin">
  <main class="container">
    <p class="eyebrow">RK SWEETS · OWNER</p>
    <h1>Welcome, <%= account.name %></h1>
    <p>You are signed in to the owner portal.</p>
    <nav class="portal-actions" aria-label="Owner account">
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button-secondary" type="submit">Sign out</button>
      </form>
    </nav>
  </main>
  <%- include('../partials/foot', { assetPrefix: '/assets' }) %>
</body>
</html>
